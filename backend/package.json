{
  "name": "annarelay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scenarios": "tsx scripts/scenarios.ts",
    "laya:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-laya.ps1",
    "laya": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-laya.ps1",
    "laya:check": "tsx scripts/laya-check.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.28.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "multer": "^2.4.0",
    "openai": "^7.31.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
