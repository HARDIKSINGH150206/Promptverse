PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
TZ_NAME=Asia/Kolkata

# Generative LLM (extraction)
LLM_PROVIDER=mock            # groq | gemini | openai | anthropic | mock
LLM_API_KEY=
LLM_MODEL=                   # blank = provider default (groq: openai/gpt-oss-120b, gemini: gemini-2.5-flash)

# Laya decision model (via Vercel AI Gateway)
DECISION_PROVIDER=llm        # llm (recommended) | hybrid (local Laya + LLM) | laya_local | laya (Vercel, needs card) | mock
LAYA_LOCAL_URL=http://127.0.0.1:8000   # npm run laya
LAYA_LOCAL_TIMEOUT_MS=8000
AI_GATEWAY_API_KEY=
LAYA_MODEL=convaiinnovations/laya-free

# Speech-to-text for POST /api/transcribe (Sarvam first, Groq Whisper as fallback)
STT_PROVIDER=sarvam         # sarvam | groq | none
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
GROQ_API_KEY=                # also used as the STT fallback
GROQ_STT_MODEL=whisper-large-v3-turbo

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ACCEPT_TIMEOUT_SECS=45
RECONFIRM_AFTER_SECS=20
RECONFIRM_TIMEOUT_SECS=30
STANDBY_TIMEOUT_SECS=45
PICKUP_BUFFER_MINS=20
AVG_SPEED_KMPH=20
RISK_THRESHOLD=0.25
INTENT_MIN_PROBABILITY=0.70
THOMPSON_SAMPLING=on         # on | off  (tests use off)
EXPLORE_MIN_SLACK_MINS=90    # explore only if this much time remains before safe_until
DEMO_SEED=42                 # makes Thompson draws repeatable for rehearsals
FALLBACK_ORDER=animal_feed,compost

# Voice agent call turns (blank AGENT_MODEL = use LLM_MODEL). none = no hidden reasoning (qwen3); gpt-oss needs low|medium|high
AGENT_MODEL=qwen/qwen3.8-27b
AGENT_REASONING=none
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_SAMPLE_RATE=16000
SARVAM_SILENCE_MS=400     # end-of-turn silence for live speech
