# mock  = everything runs in the browser, no backend needed (stage fallback)
# live  = every call goes to the backend
# mixed = only the groups in NEXT_PUBLIC_LIVE_GROUPS go to the backend
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# mixed mode only. Groups: health,directory,parse,offers,demands,board,assignments,replies,collector,impact,demo
NEXT_PUBLIC_LIVE_GROUPS=health,directory,board

# Must match the backend's TELEGRAM_BOT_USERNAME (without @). Empty = web inbox only.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
